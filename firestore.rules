rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Validation
    function isValidUser(data) {
      let requiredFields = ['uid', 'displayName', 'email', 'createdAt'];
      let allowedFields = ['uid', 'displayName', 'email', 'createdAt', 'photoURL', 'plan'];
      
      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() < 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() < 128 &&
             data.email == request.auth.token.email &&
             (data.get('photoURL', null) == null || (data.photoURL is string && data.photoURL.size() < 1000)) &&
             (data.get('plan', null) == null || data.plan in ['starter', 'pro', 'executive']);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
                      isValidUser(request.resource.data) && 
                      request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId) && 
                      isValidUser(request.resource.data) &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      request.resource.data.email == resource.data.email &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'plan']);
      
      // Roadmaps subcollection
      match /roadmaps/{roadmapId} {
        function isValidRoadmap(data) {
          let required = ['userId', 'input', 'content', 'date'];
          return data.keys().hasAll(required) &&
                 data.userId == userId &&
                 data.userId == request.auth.uid &&
                 data.content is string && data.content.size() > 0 && data.content.size() < 50000;
        }

        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidRoadmap(request.resource.data) && request.resource.data.date == request.time;
        allow delete: if isOwner(userId);
      }
    }

    // Chat Feedback
    match /chat_feedback/{feedbackId} {
      function isValidFeedback(data) {
        return data.keys().hasAll(['userId', 'messageId', 'feedback', 'timestamp']) &&
               data.userId == request.auth.uid &&
               data.feedback in ['positive', 'negative'] &&
               data.timestamp == request.time;
      }

      allow create: if isSignedIn() && isValidFeedback(request.resource.data);
      // No one can read feedback from the client for now (admin only via console)
      allow read: if false; 
    }
  }
}
